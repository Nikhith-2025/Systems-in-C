--- xv6-riscv/user/readcount.c	1970-01-01 05:30:00.000000000 +0530
+++ xv6-riscv_modified/user/readcount.c	2025-09-12 21:21:23.000000000 +0530
@@ -0,0 +1,24 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[])
+{
+    int file_descriptor;
+    char buffer[100];
+
+    printf("%d\n", getreadcount());
+
+    file_descriptor = open("README", 0); // using README as test file since it exists in xv6
+    if (file_descriptor < 0)
+    {
+        printf("failed to open file\n");
+        exit(1);
+    }
+
+    read(file_descriptor, buffer, sizeof(buffer));
+    close(file_descriptor);
+
+    printf("%d\n", getreadcount());
+    exit(0);
+}
