+// Compute process weight from nice value using integer arithmetic
+// Higher nice -> lower weight -> less CPU time
+// Lower nice -> higher weight -> more CPU time
+static uint64 calculate_weight_from_priority(int nice_value) {
+  // Clamp nice value to valid range [-20, 19]
+  if (nice_value < -20) nice_value = -20;
+  if (nice_value > 19) nice_value = 19;
+  
+  // Base weight for nice=0
+  uint64 base_weight = 1024;
+  
+  if (nice_value > 0) {
+    // Positive nice: reduce weight (lower priority)
+    // Use 4/5 ratio to approximate 1/1.25 
+    for (int i = 0; i < nice_value; i++) {
+      base_weight = (base_weight * 4 + 2) / 5; // +2 for rounding
+      if (base_weight < 1) base_weight = 1;   // Ensure minimum weight
+    }
+  } else if (nice_value < 0) {
+    // Negative nice: increase weight (higher priority)
+    // Use 5/4 ratio to approximate 1.25
+    for (int i = 0; i < -nice_value; i++) {
+      base_weight = (base_weight * 5 + 2) / 4; // +2 for rounding
+    }
+  }
+  
+  return (base_weight < 1) ? 1 : base_weight;
